{
	"name": "motomate",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"copy:scalar": "node -e \"const{cpSync}=require('fs');cpSync('node_modules/@scalar/api-reference/dist/browser/standalone.js','static/scalar.js')\"",
		"dev": "npm run copy:scalar && vite dev",
		"build": "npm run copy:scalar && vite build",
		"preview": "node server.js",
		"start": "node server.js",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:generate": "drizzle-kit generate",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"format-fix": "prettier --write . && eslint . --fix",
		"test": "svelte-kit sync && vitest run"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@scalar/api-reference": "^1.74.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/better-sqlite3": "^9.6.0",
		"@types/leaflet": "^1.9.22",
		"@types/nodemailer": "^8.0.2",
		"@types/pdfkit": "^0.17.6",
		"@types/web-push": "^3.6.4",
		"@typescript-eslint/eslint-plugin": "^8.58.0",
		"@typescript-eslint/parser": "^8.58.0",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.12.0",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "4.7.6",
		"tailwindcss": "^4.0.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.4"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1150.0",
		"@dicebear/core": "^10.7.0",
		"@dicebear/styles": "^10.6.0",
		"@fontsource/inter": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@lucia-auth/adapter-drizzle": "^1.1.0",
		"@node-rs/argon2": "^2.2.2",
		"@tiptap/core": "^3.30.4",
		"@tiptap/extension-link": "^3.26.1",
		"@tiptap/starter-kit": "^3.31.4",
		"altcha": "^3.3.0",
		"altcha-lib": "^2.6.0",
		"better-sqlite3": "^13.0.3",
		"date-fns": "^4.4.0",
		"drizzle-orm": "^0.45.4",
		"express": "^5.3.0",
		"fflate": "^0.8.3",
		"helmet": "^8.3.0",
		"leaflet": "^1.9.4",
		"leaflet-gpx": "^2.2.0",
		"lucia": "^3.2.2",
		"marked": "^18.1.1",
		"nodemailer": "^10.1.0",
		"pdf-lib": "^1.17.1",
		"pdfkit": "^0.20.2",
		"svelte-i18n": "^4.0.1",
		"tiptap-markdown": "^0.9.0",
		"web-push": "^3.6.7",
		"zod": "^4.6.7"
	},
	"allowScripts": {
		"better-sqlite3@13.0.3": true
	}
}

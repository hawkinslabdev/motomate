# Required. For AUTH_SECRET: generate with: openssl rand -hex 32. Changing it means re-entering your S3/paperless credentials!
DATABASE_URL=./data/motomate.db
AUTH_SECRET=

# Auth
AUTH_COOKIE_SECURE=false
AUTH_ALLOW_REGISTRATION=false
# ALTCHA_HMAC_KEY=change-me-min-32-chars

# OIDC. Configure /oidc/callback and /auth/logout on your IdP (pocket-id, Authelia, etc.). If you don't want to use OIDC, leave these empty.
# OIDC_ISSUER=https://idp.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid email profile
# OIDC_NAME=SSO

# Storage (S3 backup and paperless-ngx are configured per user under Settings, Integrations)
STORAGE_LOCAL_PATH=./uploads

# Email / SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@motomate.local
# SMTP_SECURE=true
# SMTP_REJECT_UNAUTHORIZED=false

# App
TZ=Europe/Amsterdam
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_APP_ORIGINS=http://localhost:5173
PUBLIC_APP_NAME=MotoMate
# BODY_SIZE_LIMIT=20971520

# Demo
PUBLIC_DEMO_ENABLED=false

# Scheduler
CRON_INTERVAL_HOURS=1

# Push notifications (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@motomate.local

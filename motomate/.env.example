# Required. AUTH_SECRET: openssl rand -hex 32
AUTH_SECRET=
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_APP_ORIGINS=http://localhost:5173
DATABASE_URL=./data/motomate.db
TZ=Europe/Amsterdam

# Auth
AUTH_COOKIE_SECURE=false
AUTH_ALLOW_REGISTRATION=false
# ALTCHA_HMAC_KEY=change-me-min-32-chars

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@motomate.local
# SMTP_SECURE=true
# SMTP_REJECT_UNAUTHORIZED=false

# Scheduler
CRON_INTERVAL_HOURS=1
NOTIFY_QUIET_HOURS=22-8

# OIDC
# OIDC_ISSUER=https://idp.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid email profile
# OIDC_NAME=SSO
# OIDC_ALLOW_SIGNUP=true
# OIDC_TRUST_UNVERIFIED_EMAIL=true

# Reverse proxy. XFF_DEPTH = number of proxies
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1

# Push notifications (VAPID). Keys are generated if empty
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@motomate.local

# Paths and limits
STORAGE_LOCAL_PATH=./uploads
# BODY_SIZE_LIMIT=20971520
PUBLIC_APP_NAME=MotoMate
PUBLIC_DEMO_ENABLED=false
